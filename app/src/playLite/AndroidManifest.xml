<?xml version="1.0" encoding="utf-8"?>
<!-- Play Lite: the Play Store build. Lite's removal (no accessibility service) plus Play's (no self-update:
     no INTERNET, no REQUEST_INSTALL_PACKAGES, no install receiver). Keep in step with src/lite and src/play. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application>
        <service
            android:name=".service.accessibility.RewireAccessibilityService"
            tools:node="remove" />
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            tools:node="remove" />
    </application>

</manifest>
