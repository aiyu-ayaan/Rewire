<?xml version="1.0" encoding="utf-8"?>
<!-- Pause → Turn: both bars draw in as a pause sign, then the right bar springs into its 45° turn. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:scaleX="0.28"
                android:scaleY="0.28"
                android:translateX="18.16"
                android:translateY="17.04">
                <path
                    android:name="pause"
                    android:pathData="M72,200 V56"
                    android:strokeColor="@color/brand_pause"
                    android:strokeWidth="34"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="turn"
                    android:pathData="M136,200 V112 L136,56"
                    android:strokeColor="@color/brand_turn"
                    android:strokeWidth="34"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="pause">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="350"
                android:interpolator="@interpolator/emphasized_decelerate"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="turn">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="350"
                    android:interpolator="@interpolator/emphasized_decelerate"
                    android:propertyName="trimPathEnd"
                    android:startOffset="120"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <!-- Overshoot stands in for a spring: AVDs have no spring physics. -->
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="pathData"
                    android:startOffset="560"
                    android:valueFrom="M136,200 V112 L136,56"
                    android:valueTo="M136,200 V112 L184,64"
                    android:valueType="pathType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
