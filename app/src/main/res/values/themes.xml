<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rewire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <!-- Launch theme for MainActivity; swaps to Theme.Rewire once the splash is installed. -->
    <style name="Theme.Rewire.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Rewire</item>
    </style>
</resources>
