<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ runs the icon animation; duration must cover splash_icon_animated. -->
    <style name="Theme.Rewire.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Rewire</item>
    </style>
</resources>
