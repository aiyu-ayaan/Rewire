<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Self-update: one GET of the public GitHub release list, and the APK download. No usage data is ever sent. Off with the auto-update switch. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Self-update: lets the user allow Rewire to hand a downloaded APK to Android's installer (the system confirmation screen is never skipped). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Focus/break alerts and ongoing session (asked with in-app rationale first, API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Enables Focus mode Do Not Disturb: silences messages while allowing incoming calls -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Enables incoming call and timer alert vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Allows Guard to display warning/block screen over guarded apps on Android 10+ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps Guard alive in background and resilient to OEM process killing -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 16+ Live Update: focus countdown chip in the status bar (normal permission) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Focus timer: CPU kept awake only until the running phase ends, so chimes ring on time with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Restores monitoring state on device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Usage access (user grants in system settings): screen-time stats for Matrix. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Protected-app picker lists launchable apps only (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RewireApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Rewire">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rewire.Starting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Warning / block screen shown over protected apps. Own task, hidden from recents. -->
        <activity
            android:name=".feature.guard.GuardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Rewire" />

        <!-- Detects which protected app opened. Enabled by the user in Accessibility settings. -->
        <service
            android:name=".service.accessibility.RewireAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground service keeping habit guard alive in background -->
        <service
            android:name=".service.monitoring.GuardMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Habit guard monitoring to enforce configured friction and daily limits" />
        </service>

        <!-- Runs the focus timer when the app is minimised, swiped away or the screen is off -->
        <service
            android:name=".service.focus.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started focus session timer that must keep counting and chime at phase ends" />
        </service>

        <!-- Answers the PackageInstaller session an update starts (confirmation screen / failure reason) -->
        <receiver android:name=".core.update.UpdateInstallReceiver" android:exported="false" />

        <!-- Restores background monitoring on device boot and after an update -->
        <receiver
            android:name=".service.boot.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
