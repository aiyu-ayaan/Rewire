<?xml version="1.0" encoding="utf-8"?>
<!-- Play: no self-update. Removes the permissions and receiver only the GitHub updater needs
     (INTERNET is used by nothing else); BuildConfig.UPDATES = false hides and skips the code paths. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application>
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            tools:node="remove" />
    </application>

</manifest>
